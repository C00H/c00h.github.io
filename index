  <meta name="theme-color" content="#ffffff">
  <title>Shuoqi Li | Home</title>
  <style>
    :root {
      color-scheme: light;
      --ink: #30343b;
      --muted: #616771;
      --line: #e9e9ec;
      --accent: #a1456d;
      --accent-soft: #fbf2f6;
      --paper: #fff;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { margin: 0; background: var(--paper); color: var(--ink); font-size: 16px; line-height: 1.65; }
    a { color: #815078; text-decoration-thickness: 1px; text-underline-offset: 3px; }
    a:hover { color: #5f2b4c; }
    a:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; border-radius: 2px; }
    .skip { position: absolute; top: -80px; left: 20px; padding: 8px 12px; background: #fff; z-index: 20; }
    .skip:focus { top: 10px; }
    .topbar { position: sticky; top: 0; z-index: 10; background: rgba(255,255,255,.97); border-top: 2px solid #e2a5be; border-bottom: 1px solid var(--line); }
    .topbar-inner { width: min(1210px, calc(100% - 48px)); margin: auto; display: flex; align-items: center; gap: 43px; min-height: 63px; }
    .topbar a { color: #51565f; text-decoration: none; font-size: 14px; white-space: nowrap; }
    .topbar a:hover, .topbar a:focus-visible { color: var(--accent); }
    .topbar .home { color: var(--accent); font-weight: 700; margin-right: 9px; }
    .page { width: min(1210px, calc(100% - 48px)); margin: 43px auto 90px; display: grid; grid-template-columns: 248px minmax(0, 1fr); gap: clamp(38px, 5vw, 76px); }
    .profile { position: sticky; top: 105px; align-self: start; }
    .portrait { width: 196px; height: 196px; border-radius: 50%; display: block; object-fit: cover; object-position: 58% center; border: 7px solid #fff; outline: 1px solid #ece4e9; }
    .profile h1 { font-size: 25px; line-height: 1.2; margin: 22px 0 9px; letter-spacing: -.025em; }
    .profile .title { margin: 0; color: var(--muted); line-height: 1.5; }
    .profile .bio { margin: 20px 0 19px; color: var(--muted); font-size: 14px; }
    .profile-links { display: grid; gap: 8px; margin-top: 17px; }
    .profile-links a, .profile-links span { display: flex; align-items: center; gap: 10px; font-size: 14px; color: #4b5058; text-decoration: none; }
    .profile-links a:hover { color: var(--accent); }
    .icon { display: inline-flex; align-items: center; justify-content: center; width: 20px; flex: 0 0 20px; color: var(--accent); font-size: 16px; }
    .main { min-width: 0; }
    .intro { padding: 1px 0 7px; }
    .intro p { margin: 0 0 17px; font-size: 17px; line-height: 1.65; }
    .intro strong { color: #41454c; }
    .intro .detail { color: var(--muted); font-size: 16px; }
    .section { margin-top: 43px; scroll-margin-top: 85px; }
    .section h2 { display: flex; align-items: baseline; gap: 10px; margin: 0 0 18px; padding-bottom: 9px; border-bottom: 1px solid var(--line); font-size: 23px; letter-spacing: -.025em; line-height: 1.35; }
    .section h2 .marker { color: var(--accent); font-size: 17px; line-height: 1; }
    .news-list, .honors-list { list-style: none; padding: 0; margin: 0; }
    .news-list li { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 13px; padding: 7px 0; }
    .news-list time { color: #817b82; font-size: 14px; font-variant-numeric: tabular-nums; }
    .news-list p { margin: 0; }
    .research-item { display: grid; grid-template-columns: 1fr auto; gap: 5px 22px; padding: 15px 0 19px; border-bottom: 1px solid var(--line); }
    .research-item:first-of-type { padding-top: 2px; }
    .research-item h3 { margin: 0; font-size: 17px; line-height: 1.35; }
    .research-item time { color: #747983; font-size: 14px; white-space: nowrap; }
    .research-item .role { grid-column: 1 / -1; color: #6b7078; font-size: 14px; }
    .research-item p { grid-column: 1 / -1; margin: 5px 0 0; color: #555b64; }
    .paper-group { margin: 22px 0 10px; font-size: 15px; font-weight: 700; color: #67616a; }
    .paper { display: grid; grid-template-columns: 89px minmax(0, 1fr); gap: 20px; padding: 14px 0 20px; border-bottom: 1px solid var(--line); }
    .paper .badge { align-self: start; display: inline-block; margin-top: 3px; padding: 4px 7px; border: 1px solid #e8cbd7; border-radius: 4px; background: var(--accent-soft); color: #8c4162; font-size: 12px; line-height: 1.35; text-align: center; }
    .paper h3 { margin: 0 0 4px; font-size: 16px; line-height: 1.45; font-weight: 700; }
    .paper h3 a { color: #414b5c; text-decoration: none; }
    .paper h3 a:hover { color: var(--accent); text-decoration: underline; }
    .paper p { margin: 0; color: #6b7078; font-size: 14px; }
    .paper .paper-links { margin-top: 5px; font-size: 13px; }
    .paper .paper-links a { margin-right: 13px; }
    .honors-list li { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 13px; padding: 8px 0; }
    .honors-list span:first-child { color: #817b82; font-size: 14px; }
    .education { display: grid; gap: 18px; }
    .education article { display: grid; grid-template-columns: 1fr auto; gap: 2px 20px; }
    .education h3 { margin: 0; font-size: 17px; }
    .education time { color: #747983; font-size: 14px; white-space: nowrap; }
    .education p { grid-column: 1 / -1; margin: 0; color: #60656e; }
    footer { margin-top: 50px; padding-top: 18px; border-top: 1px solid var(--line); color: #85818a; font-size: 13px; }
    @media (max-width: 900px) {
      .topbar-inner { gap: 25px; overflow-x: auto; scrollbar-width: none; }
      .topbar-inner::-webkit-scrollbar { display: none; }
      .page { grid-template-columns: 215px minmax(0,1fr); gap: 35px; }
      .portrait { width: 165px; height: 165px; }
    }
    @media (max-width: 720px) {
      .topbar-inner, .page { width: min(100% - 34px, 1210px); }
      .topbar-inner { min-height: 56px; }
      .page { display: block; margin-top: 26px; }
      .profile { position: static; display: grid; grid-template-columns: 94px 1fr; gap: 0 18px; padding-bottom: 25px; border-bottom: 1px solid var(--line); margin-bottom: 27px; }
      .portrait { grid-row: span 3; width: 88px; height: 88px; border-width: 4px; }
      .profile h1 { margin: 2px 0 3px; font-size: 23px; }
      .profile .title { font-size: 14px; }
      .profile .bio { display: none; }
      .profile-links { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 7px 16px; margin-top: 18px; }
      .intro p { font-size: 16px; }
      .intro .detail { font-size: 15px; }
      .section { margin-top: 35px; }
    }
    @media (max-width: 480px) {
      .research-item { grid-template-columns: 1fr; }
      .research-item time { grid-row: 2; }
      .paper { grid-template-columns: 1fr; gap: 7px; }
      .paper .badge { justify-self: start; }
      .education article { grid-template-columns: 1fr; }
      .education time { grid-row: 2; }
      .news-list li, .honors-list li { grid-template-columns: 80px minmax(0,1fr); gap: 7px; }
    }
    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  </style>
